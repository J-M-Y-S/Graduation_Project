# ---------------------------------------------------------------------------
# Unity 项目忽略规则
#
# 原则：只提交源码与工程配置（Assets / Packages / ProjectSettings），
#       凡由 Unity 或 IDE 自动生成的缓存、构建产物一律忽略。
# 生效方式见同目录 README.md。
# ---------------------------------------------------------------------------

# --- Unity 自动生成目录 ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# --- Asset Store 工具与自动生成的插件 ---
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# --- IDE / 编辑器缓存 ---
/.vs/
/.vscode/
/.idea/
/.gradle/
ExportedObj/
.consulo/

# --- IDE 自动生成的工程文件（Unity 会重新生成）---
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# --- Unity 生成的元数据 ---
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- 崩溃报告 ---
sysinfo.txt

# --- 构建产物 ---
*.apk
*.aab
*.unitypackage
*.app

# --- Addressables 打包产物 ---
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# --- 其他 ---
crashlytics-build.properties
UpgradeLog.htm
UpgradeLog*.htm
*.stackdump
